# Serviço bot: vereditos de bot, API 9002 (HTTPS pública, com chave) e 9003 (HTTP interna: loopback e a bridge do
# traefik). Spec 016 RF-14, spec 018, ADR 0047 itens 2, 4 e 5.
[Unit]
Description=finger-sniffer: bot
# Depois do store (assina fs.v1.store.connection) e do Docker: a 9003 escuta no IP do host na bridge
# br-net-public do traefik, que só existe com o Docker no ar (só ordem: o espelho não sobe nem para o Docker).
After=finger-sniffer-net.service finger-sniffer-nats.service finger-sniffer-store.service docker.service
Wants=finger-sniffer-nats.service
PartOf=finger-sniffer.target

[Service]
Type=simple
User=finger-sniffer
Group=finger-sniffer
EnvironmentFile=/finger-sniffer/etc/finger-sniffer.env
ExecStart=/finger-sniffer/bin/finger-sniffer-bot
Restart=always
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30
# Limites no finger-01 (ADR 0047 item 5, ADR 0039): fatia comum, sem swap, GOMEMLIMIT abaixo do MemoryMax e cota de
# CPU. disablethp: o heap Go fica fora do THP "always" do host.
Slice=finger-sniffer.slice
Environment=GOMEMLIMIT=768MiB GODEBUG=disablethp=1
MemoryMax=1G
MemorySwapMax=0
CPUQuota=200%
LimitNOFILE=65536
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
# Banco do bot em disco (ADR 0047 item 2), fora do tmpfs do store; o deploy nunca apaga var/bot. Caminhos por
# unit (spec 016 RF-06, ADR 0075 item 2): os certificados (var/certs) são só lidos; o resto de var/ fica
# inacessível (prefixo -: não falha se o diretório não existir).
ReadWritePaths=/finger-sniffer/var/bot
InaccessiblePaths=-/finger-sniffer/var/acme -/finger-sniffer/var/store -/finger-sniffer/var/nats
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# ADR 0075 item 2: sem acesso a relógio, log do kernel e hostname; arquivos novos só do dono; /proc
# sem os processos alheios (sem ProcSubset=pid: o health do store lê /proc/sys, /proc/net e /proc/modules).
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
UMask=0077
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=finger-sniffer.target
