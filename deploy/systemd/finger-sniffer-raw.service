# Serviço raw (spec 001, spec 016 RF-05..RF-07, ADR 0039).
[Unit]
Description=finger-sniffer: raw
After=finger-sniffer-net.service finger-sniffer-nats.service finger-sniffer-store.service
Wants=finger-sniffer-nats.service
PartOf=finger-sniffer.target

[Service]
Type=simple
User=finger-sniffer
Group=finger-sniffer
EnvironmentFile=/finger-sniffer/etc/finger-sniffer.env
ExecStart=/finger-sniffer/bin/finger-sniffer-raw
Restart=always
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30
# Limites no finger-01 (ADR 0039): fatia comum, sem swap, GOMEMLIMIT abaixo do MemoryMax e cota de CPU
# (o GOMAXPROCS do runtime Go segue o CPUQuota). disablethp: o heap Go fica fora do THP "always" do host.
Slice=finger-sniffer.slice
Environment=GOMEMLIMIT=192MiB GODEBUG=disablethp=1
MemoryMax=256M
MemorySwapMax=0
CPUQuota=100%
LimitNOFILE=65536
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
# Caminhos por unit (spec 016 RF-06, ADR 0075 item 2): só lê var/certs (TLS opcional); o resto de var/ fica
# inacessível (prefixo -: não falha se o diretório não existir).
InaccessiblePaths=-/finger-sniffer/var/acme -/finger-sniffer/var/bot -/finger-sniffer/var/store -/finger-sniffer/var/nats
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# ADR 0075 item 2: sem acesso a relógio, log do kernel e hostname; arquivos novos só do dono; /proc
# sem os processos alheios (sem ProcSubset=pid: o health do store lê /proc/sys, /proc/net e /proc/modules).
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
UMask=0077
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=finger-sniffer.target
