# Serviço store (spec 001, spec 016 RF-05..RF-07a, ADRs 0039 e 0045).
[Unit]
Description=finger-sniffer: store
After=finger-sniffer-net.service finger-sniffer-nats.service
Wants=finger-sniffer-nats.service
PartOf=finger-sniffer.target
# Banco no tmpfs dedicado (ADR 0045): monta antes de subir; reiniciar o store não desmonta (o banco fica)
RequiresMountsFor=/finger-sniffer/var/store

[Service]
Type=simple
User=finger-sniffer
Group=finger-sniffer
EnvironmentFile=/finger-sniffer/etc/finger-sniffer.env
ExecStart=/finger-sniffer/bin/finger-sniffer-store
Restart=always
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30
# Limites no finger-01 (ADRs 0039 e 0045): fatia comum, sem swap, GOMEMLIMIT abaixo do MemoryMax e cota de CPU
# (o GOMAXPROCS do runtime Go segue o CPUQuota). disablethp: o heap Go fica fora do THP "always" do host.
# MemoryMax 6G = tmpfs do banco 4G (shmem cobrado do store, sem swap) + GOMEMLIMIT 1536MiB + ~512 MiB de kernel,
# sock e binário (ADR 0045 item 3): o tmpfs enche (ENOSPC) antes de o cgroup chegar ao MemoryMax.
Slice=finger-sniffer.slice
Environment=GOMEMLIMIT=1536MiB GODEBUG=disablethp=1
MemoryMax=6G
MemorySwapMax=0
CPUQuota=400%
LimitNOFILE=65536
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
# Caminhos por unit (spec 016 RF-06, ADR 0075 item 2): grava só o banco (var/store) e lê var/certs (TLS da
# 9000); o resto de var/ fica inacessível (prefixo -: não falha se o diretório não existir).
ReadWritePaths=/finger-sniffer/var/store
InaccessiblePaths=-/finger-sniffer/var/acme -/finger-sniffer/var/bot -/finger-sniffer/var/nats
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# ADR 0075 item 2: sem acesso a relógio, log do kernel e hostname; arquivos novos só do dono; /proc
# sem os processos alheios (sem ProcSubset=pid: o health do store lê /proc/sys, /proc/net e /proc/modules).
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
UMask=0077
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=finger-sniffer.target
