# Serviço store (spec 001, spec 016 RF-05..RF-07, ADR 0039).
[Unit]
Description=finger-sniffer: store
After=finger-sniffer-net.service finger-sniffer-nats.service
Wants=finger-sniffer-nats.service
PartOf=finger-sniffer.target

[Service]
Type=simple
User=finger-sniffer
Group=finger-sniffer
EnvironmentFile=/finger-sniffer/etc/finger-sniffer.env
ExecStart=/finger-sniffer/bin/finger-sniffer-store
Restart=always
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30
# Limites no finger-01 (ADR 0039): fatia comum, sem swap, GOMEMLIMIT abaixo do MemoryMax e cota de CPU
# (o GOMAXPROCS do runtime Go segue o CPUQuota). disablethp: o heap Go fica fora do THP "always" do host.
Slice=finger-sniffer.slice
Environment=GOMEMLIMIT=1792MiB GODEBUG=disablethp=1
MemoryMax=2G
MemorySwapMax=0
CPUQuota=400%
LimitNOFILE=65536
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/finger-sniffer/var
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=finger-sniffer.target
