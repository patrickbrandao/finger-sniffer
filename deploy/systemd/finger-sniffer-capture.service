# Serviço capture (spec 001, spec 016 RF-05..RF-07).
[Unit]
Description=finger-sniffer: capture
After=finger-sniffer-net.service finger-sniffer-nats.service finger-sniffer-store.service
Wants=finger-sniffer-nats.service
PartOf=finger-sniffer.target

[Service]
Type=simple
User=finger-sniffer
Group=finger-sniffer
EnvironmentFile=/finger-sniffer/etc/finger-sniffer.env
ExecStart=/finger-sniffer/bin/finger-sniffer-capture
Restart=always
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30
Environment=GOMEMLIMIT=80MiB
MemoryMax=96M
LimitNOFILE=65536
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/finger-sniffer/var
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_PACKET AF_NETLINK

[Install]
WantedBy=finger-sniffer.target
