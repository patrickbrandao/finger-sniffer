# Serviço capture (spec 001, spec 016 RF-05..RF-07, ADR 0039).
[Unit]
Description=finger-sniffer: capture
After=finger-sniffer-net.service finger-sniffer-nats.service finger-sniffer-store.service
Wants=finger-sniffer-nats.service
PartOf=finger-sniffer.target

[Service]
Type=simple
User=finger-sniffer
Group=finger-sniffer
EnvironmentFile=/finger-sniffer/etc/finger-sniffer.env
ExecStart=/finger-sniffer/bin/finger-sniffer-capture
Restart=always
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30
# Limites no finger-01 (ADR 0039): fatia comum, sem swap, GOMEMLIMIT abaixo do MemoryMax e cota de CPU
# (o GOMAXPROCS do runtime Go segue o CPUQuota). disablethp: o heap Go fica fora do THP "always" do host.
Slice=finger-sniffer.slice
# Journal próprio do espelho (spec 016 RF-08, ADR 0075 item 3): 24 h / 200 MB sem tocar o journal do host.
# Leitura: journalctl --namespace=finger-sniffer -u finger-sniffer-*.
LogNamespace=finger-sniffer
Environment=GOMEMLIMIT=384MiB GODEBUG=disablethp=1
MemoryMax=512M
MemorySwapMax=0
CPUQuota=200%
LimitNOFILE=65536
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
# Caminhos por unit (spec 016 RF-06, ADR 0075 item 2): não grava nem lê nada em var/, que fica inacessível
# (prefixo -: não falha se o diretório não existir).
InaccessiblePaths=-/finger-sniffer/var
# Usuário do NATS do serviço (ADR 0075 item 1.3): definido na unit, nunca no env compartilhado (o
# EnvironmentFile vence o Environment=). Só a própria senha é legível: o auth.conf do NATS e as senhas dos
# outros serviços ficam inacessíveis (spec 016 RF-06).
Environment=FS_NATS_USER=capture FS_NATS_PASSWORD_FILE=/finger-sniffer/etc/nats/capture.password
InaccessiblePaths=-/finger-sniffer/etc/nats/auth.conf -/finger-sniffer/etc/nats/web.password -/finger-sniffer/etc/nats/raw.password -/finger-sniffer/etc/nats/dns.password -/finger-sniffer/etc/nats/store.password -/finger-sniffer/etc/nats/bot.password
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# ADR 0075 item 2: sem acesso a relógio, log do kernel e hostname; arquivos novos só do dono; /proc
# sem os processos alheios (sem ProcSubset=pid: o health do store lê /proc/sys, /proc/net e /proc/modules).
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
UMask=0077
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_PACKET AF_NETLINK

[Install]
WantedBy=finger-sniffer.target
