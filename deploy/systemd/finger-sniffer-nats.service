# Barramento local NATS + JetStream (ADR 0003).
[Unit]
Description=finger-sniffer: NATS
After=finger-sniffer-net.service
PartOf=finger-sniffer.target

[Service]
Type=simple
User=finger-sniffer
Group=finger-sniffer
ExecStart=/finger-sniffer/bin/nats-server -c /finger-sniffer/eventbus/nats/nats.conf
Restart=always
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30
# Limites no finger-01 (ADR 0039): fatia comum, sem swap, GOMEMLIMIT abaixo do MemoryMax e cota de CPU
# (o GOMAXPROCS do runtime Go segue o CPUQuota). disablethp: o heap Go fica fora do THP "always" do host.
Slice=finger-sniffer.slice
Environment=GOMEMLIMIT=896MiB GODEBUG=disablethp=1
MemoryMax=1G
MemorySwapMax=0
CPUQuota=200%
LimitNOFILE=65536
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
# Caminhos por unit (spec 016 RF-06, ADR 0075 item 2): grava só o JetStream (var/nats); o resto de var/ fica
# inacessível (prefixo -: não falha se o diretório não existir).
ReadWritePaths=/finger-sniffer/var/nats
InaccessiblePaths=-/finger-sniffer/var/acme -/finger-sniffer/var/bot -/finger-sniffer/var/certs -/finger-sniffer/var/store
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# ADR 0075 item 2: sem acesso a relógio, log do kernel e hostname; arquivos novos só do dono; /proc
# sem os processos alheios (sem ProcSubset=pid: o health do store lê /proc/sys, /proc/net e /proc/modules).
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
UMask=0077
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=finger-sniffer.target
