# Serviço web (spec 001, spec 016 RF-05..RF-07).
[Unit]
Description=finger-sniffer: web
After=finger-sniffer-net.service finger-sniffer-nats.service finger-sniffer-store.service
Wants=finger-sniffer-nats.service
PartOf=finger-sniffer.target

[Service]
Type=simple
User=finger-sniffer
Group=finger-sniffer
EnvironmentFile=/finger-sniffer/etc/finger-sniffer.env
ExecStart=/finger-sniffer/bin/finger-sniffer-web
Restart=always
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30
Environment=GOMEMLIMIT=80MiB
# QUIC sem GSO nem ECN (ADR 0019): cada datagrama sai como o quic-go o montou e a captura vê o fio.
Environment=QUIC_GO_DISABLE_GSO=true QUIC_GO_DISABLE_ECN=true
MemoryMax=96M
LimitNOFILE=65536
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/finger-sniffer/var
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# UDP 443 (QUIC) usa AF_INET/AF_INET6 e o mesmo CAP_NET_BIND_SERVICE das portas TCP.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=finger-sniffer.target
