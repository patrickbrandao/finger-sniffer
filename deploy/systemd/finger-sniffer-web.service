# Serviço web (spec 001, spec 016 RF-05..RF-07, ADR 0039).
[Unit]
Description=finger-sniffer: web
After=finger-sniffer-net.service finger-sniffer-nats.service finger-sniffer-store.service
Wants=finger-sniffer-nats.service
PartOf=finger-sniffer.target

[Service]
Type=simple
User=finger-sniffer
Group=finger-sniffer
EnvironmentFile=/finger-sniffer/etc/finger-sniffer.env
ExecStart=/finger-sniffer/bin/finger-sniffer-web
Restart=always
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30
# Limites no finger-01 (ADR 0039): fatia comum, sem swap, GOMEMLIMIT abaixo do MemoryMax e cota de CPU
# (o GOMAXPROCS do runtime Go segue o CPUQuota). disablethp: o heap Go fica fora do THP "always" do host.
Slice=finger-sniffer.slice
Environment=GOMEMLIMIT=512MiB GODEBUG=disablethp=1
MemoryMax=768M
MemorySwapMax=0
CPUQuota=400%
LimitNOFILE=65536
# QUIC sem GSO nem ECN (ADR 0019): cada datagrama sai como o quic-go o montou e a captura vê o fio.
Environment=QUIC_GO_DISABLE_GSO=true QUIC_GO_DISABLE_ECN=true
# Portas 8080/8443 (TCP) e 8443 (UDP) acima de 1024: sem CAP_NET_BIND_SERVICE (ADR 0038 item 3).
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/finger-sniffer/var
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# UDP 8443 (QUIC) usa AF_INET/AF_INET6.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=finger-sniffer.target
