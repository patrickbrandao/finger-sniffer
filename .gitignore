# Fila de trabalho e temporários (obrigatório)
/tasks/
/tmp/
/.grill/

# Artefatos de build
/bin/
/dist/
*.test
*.out
coverage.*

# Dados locais e de runtime
/var/
*.sqlite
*.sqlite-*
*.db
*.pcap
*.pcapng
!pkg/**/testdata/**/*.pcap
!pkg/**/testdata/**/*.pcapng
!internal/**/testdata/**/*.pcap
!internal/**/testdata/**/*.pcapng
# golden pcaps da task 013
!test/golden/pcaps/*.pcap

# Segredos e configuração local
.env
*.env
!.env.example
# Versões fixadas do deploy (não é segredo)
!deploy/versions.env
*.key
*.pem
!**/testdata/**/*.pem
!**/testdata/**/*.key

# Logs (gabaritos de teste em testdata são versionados)
*.log
!**/testdata/**/*.log

# Sistema e editores
.DS_Store
.idea/
.vscode/
*.swp

# Dependências Node do validador de examples do asyncapi (scripts/asyncapi-examples)
node_modules/
