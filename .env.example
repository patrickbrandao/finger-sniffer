# finger-sniffer — configuração compartilhada por todas as units (EnvironmentFile).
# Instalado como /finger-sniffer/etc/finger-sniffer.env no primeiro deploy e nunca sobrescrito depois; a cada deploy
# as chaves novas daqui são acrescentadas ao do servidor (deploy/env-merge.sh), sem mudar as existentes.
# Não há segredos de terceiros: conta ACME e chaves são geradas em /finger-sniffer/var/.

# --- Rede ---
# Endereços do finger-01 (ADR 0038)
FS_LISTEN_IPV4=170.247.40.86
FS_LISTEN_IPV6=2804:231c:e500:cafe::86
# Limite de simultâneas (web e raw, ADR 0035) e modo degradado do store (spec 004 RF-11): acima disso, novas conexões
# sem pcap nem bytes crus. Padrões acima da garantia do RNF-01 (400 e 100/s), com margem para o tráfego alheio,
# inclusive o dos sites atrás do traefik, agora capturado (ADRs 0030 e 0039).
# FS_MAX_CONNS=0 só tem efeito no store (degrada todas as conexões); web e raw tratam <= 0 como o padrão, com aviso
# (ADR 0034)
FS_MAX_CONNS=1000
FS_MAX_NEW_CONNS_PER_S=250

# --- Captura (capture) ---
# NIC do finger-01 (vmxnet3, ADR 0038)
FS_CAPTURE_IFACE=ens192
# Portas excluídas da captura (ssh 48022, snmpd 48161, API 9000/9001, bot 9002/9003; ADR 0047 item 4). A captura inclui 80/443/8081 do traefik e o
# tráfego dos sites (ADR 0038); nunca excluir 8080/8443 (web do espelho, TCP e UDP 8443 do QUIC)
FS_CAPTURE_EXCLUDE_PORTS=48022,48161,9000,9001,9002,9003
FS_CAPTURE_SNAPLEN=65535
# Lote FSPB v1 (spec 003 RF-04) e tempo de retenção do bloco no anel TPACKET_V3
FS_CAPTURE_BATCH_MAX=256
FS_CAPTURE_BATCH_WAIT=5ms
FS_CAPTURE_BLOCK_TIMEOUT=10ms
# Estado da rede gravado pela unit finger-sniffer-net (fallback quando o ethtool não responde)
FS_NET_STATUS_FILE=/run/finger-sniffer/net-status.json

# --- Barramento ---
FS_NATS_URL=nats://127.0.0.1:4222
# Credenciais do NATS (ADR 0075 item 1.3): FS_NATS_USER, FS_NATS_PASSWORD_FILE e FS_NATS_PASSWORD são chaves de
# unit (Environment= em cada finger-sniffer-<svc>.service, senha em /finger-sniffer/etc/nats/<svc>.password, gerada
# pelo deploy). Nunca neste arquivo: aqui elas venceriam as das units e apagariam o usuário de todos os serviços.
FS_PRODUCER_BUFFER_MAX_AGE=30s
FS_PRODUCER_BUFFER_MAX_BYTES=16777216
FS_HEARTBEAT_INTERVAL=5s

# --- Store e retenção ---
FS_STORE_DB=/finger-sniffer/var/store/finger-sniffer.sqlite
FS_RETENTION=10m
# Teto do banco (3 GiB, ADR 0045 item 3): 75% do tmpfs de 4G em /finger-sniffer/var/store, em páginas usadas
FS_STORE_MAX_BYTES=3221225472
FS_PCAP_MAX_BYTES_PER_CONN=16777216
# Teto de bytes crus inline por campo de evento (ADR 0018); FS_RAW_BODY_MAX_BYTES nunca acima dele
FS_EVENT_INLINE_MAX=131072
FS_RAW_BODY_MAX_BYTES=131072
# Bytes completos pelo fluxo de aplicação (web e raw), por sentido e por conexão (ADR 0018)
FS_RAW_STREAM_MAX_BYTES=16777216
FS_TCP_SEGMENTS_TRACKED=32
# Folga depois do FIN dos dois lados sem o ACK final para fechar o fluxo (0 a 500ms, spec 004 RNF-01)
FS_TCP_CLOSE_GRACE=100ms
FS_P0F_DB=/finger-sniffer/etc/p0f.fp
# Sem heartbeat por este tempo, o serviço aparece como down no health (spec 004)
FS_HEALTH_DOWN_AFTER=15s
# sysctl esperado (spec 016), comparado pelo health com o kernel
FS_SYSCTL_FILE=/finger-sniffer/deploy/sysctl/90-finger-sniffer.conf

# --- API (store, sem captura) ---
FS_API_HTTPS_PORT=9000
FS_API_HTTP_PORT=9001
# Tempo real (SSE/WS, spec 004 RF-08, ADR 0020): fila por cliente (eventos; cheia = descarte com stream.dropped)
FS_LIVE_BUFFER=1024
# Clientes de tempo real simultâneos (SSE + WS); acima disso, 503
FS_LIVE_MAX_CLIENTS=64

# --- Web (portas capturadas) ---
# TCP 80/443 e UDP 443 são do traefik; o web fica em 8080/8443, com detecção pelos primeiros bytes nas duas (ADR 0038)
FS_WEB_TCP_PORTS=8080,8443
# UDP 8443 = QUIC/HTTP/3 (spec 011), mesmo número do TCP com TLS: Alt-Svc h3=":8443" e o dns anuncia alpn="h3,h2" em
# _8443._https.<nome> (ADR 0038)
FS_WEB_UDP_PORTS=8443
FS_HTDOCS=/finger-sniffer/htdocs
FS_IDLE_DEFAULT=120s
FS_IDLE_MAX=600s
FS_DELAY_MAX=60s
FS_SIZE_MAX=67108864
FS_HSIZE_MAX=1048576
FS_MAX_H2_PRIORITY_FRAMES=10000
# Orçamento global de memória de entrada do web em bytes (spec 005 RF-12, ADRs 0033, 0036 e 0039): cabeçalhos HTTP/1,
# campos h2, HEADERS h3, sessões WebSocket (2 MiB cada) e o pendente do fluxo cru reservam daqui a memória que
# alocam; sem espaço, 431/503/H3_EXCESSIVE_LOAD. Aceita 8–256 MiB (192 MiB), ADR 0039
FS_WEB_INPUT_BUDGET=201326592
# Campos HTTP/1 que indicam proxy no caminho (spec 009 RF-07), separados por vírgula; "*" no fim casa prefixo
# (ex.: Via,X-Cache*). Vazio = lista padrão do pkg/h1 (Via, Forwarded, X-Forwarded-*, X-Cache*, ...)
FS_WEB_PROXY_FIELDS=

# --- Raw (portas cruas: porta:modo) ---
FS_RAW_PORTS=7:echo,21:banner,22:banner,25:banner,110:banner,143:banner,587:banner,993:tls-banner

# --- DNS autoritativo ---
# Zona dos probes, delegada para finger-01.badblock.net.br (ADR 0038)
FS_DNS_ZONE=finger-west-01.badblock.net.br
FS_DNS_TTL=5s
FS_DNS_RRL_PER_IP=20

# --- Certificados (ACME) ---
FS_CERT_DIR=/finger-sniffer/var/certs
# ACME só roda com 1 (spec 015 RF-01); 0 usa o que houver em FS_CERT_DIR ou o autoassinado (a task 231 liga no
# servidor)
FS_ACME_ENABLE=0
# Estado do certmagic (conta, chaves, travas)
FS_ACME_DIR=/finger-sniffer/var/acme
FS_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# E-mail da conta ACME (opcional, não é segredo)
FS_ACME_EMAIL=
# Certificado A: DNS-01 pelo nosso dns (ADR 0038)
FS_CERT_NAMES_DNS01=finger-west-01.badblock.net.br,*.finger-west-01.badblock.net.br
# Certificado B: TLS-ALPN-01 pelo passthrough do traefik até a 8443 (ADR 0038); o nome da variável fica por
# compatibilidade do env instalado. Só finger-01.badblock.net.br: finger-01.tmsoft.com.br fica com o traefik
# (decisão do humano, task 232) e o desafio dele não chegaria ao web
FS_CERT_NAMES_HTTP01=finger-01.badblock.net.br

# --- Bot (vereditos, spec 018; portas fora da captura) ---
# 9002 HTTPS pública em FS_LISTEN_IPV4/FS_LISTEN_IPV6 (chave obrigatória); 9003 HTTP em 127.0.0.1 e FS_BOT_INTERNAL_LISTEN
FS_BOT_PUBLIC_PORT=9002
FS_BOT_INTERNAL_PORT=9003
# IP do host na bridge do traefik (IP ou IP/len); vazio = só 127.0.0.1. No finger-01: o gateway de br-net-public
# (rede Docker network_public do traefik-app), 10.249.255.254/16 (task 269)
FS_BOT_INTERNAL_LISTEN=10.249.255.254/16
# Redes de origem aceitas na 9003 além do loopback (vírgulas); vazio = a sub-rede de FS_BOT_INTERNAL_LISTEN.
# No finger-01: a sub-rede IPv4 da bridge (containers atrás do traefik)
FS_BOT_INTERNAL_ALLOW=10.249.0.0/16
# Banco em disco (fora do tmpfs, nunca apagado pelo deploy) e teto em bytes (2 GiB)
FS_BOT_DB=/finger-sniffer/var/bot/bot.db
FS_BOT_MAX_BYTES=2147483648
FS_BOT_FLUSH_INTERVAL=5s
# Agregados com IP: no máximo 7 dias (ADR 0052)
FS_BOT_AGG_RETENTION=168h
FS_BOT_CONN_TTL=10m
FS_BOT_MAX_CONNS=100000
# Teto aproximado em bytes do índice em memória (conexões do store e do traefix); despeja as mais antigas
# (ADR 0057). 320 MiB (ADR 0079); nunca abaixo de 256 MiB sem nova medida da carga hostil.
FS_BOT_INDEX_MAX_BYTES=335544320
FS_BOT_VIEW_WAIT=100ms
FS_BOT_RATE_HIGH=120
# Atualização diária das listas: horário aleatório na primeira hora depois deste (HH:MM UTC)
FS_BOT_LIST_REFRESH_AT=04:00
# ja4db da FoxIO (ADR 0050 item 2): desligada até o humano confirmar os termos (P4, ADR 0056 item 1). Desligada,
# nada é baixado nem lido de var/bot/lists/ja4db.json
FS_BOT_JA4DB_ENABLE=false
FS_BOT_JA4DB_URL=https://ja4db.com/api/read/
# p0f.fp do palpite de SO da visão TCP do traefix (tcp.syn, ADR 0063 item 5), o mesmo do store; ausente ou
# inválido, a visão TCP do traefix fica sem SO
FS_BOT_P0F_DB=/finger-sniffer/etc/p0f.fp
# Listas de IP de robôs e nuvens (catálogo fixo, ADR 0050 item 3), baixadas para var/bot/lists/ (ao lado de
# FS_BOT_DB). Só HTTPS; descomente para trocar a URL padrão de uma lista:
#FS_BOT_LIST_GOOGLEBOT_URL=https://developers.google.com/static/crawling/ipranges/common-crawlers.json
#FS_BOT_LIST_GOOGLE_SPECIAL_CRAWLERS_URL=https://developers.google.com/static/crawling/ipranges/special-crawlers.json
#FS_BOT_LIST_GOOGLE_USER_TRIGGERED_URL=https://developers.google.com/static/crawling/ipranges/user-triggered-fetchers.json
#FS_BOT_LIST_GOOGLE_USER_TRIGGERED_GOOGLE_URL=https://developers.google.com/static/crawling/ipranges/user-triggered-fetchers-google.json
#FS_BOT_LIST_BINGBOT_URL=https://www.bing.com/toolbox/bingbot.json
#FS_BOT_LIST_APPLEBOT_URL=https://search.developer.apple.com/applebot.json
#FS_BOT_LIST_OPENAI_GPTBOT_URL=https://openai.com/gptbot.json
#FS_BOT_LIST_OPENAI_SEARCHBOT_URL=https://openai.com/searchbot.json
#FS_BOT_LIST_OPENAI_CHATGPT_USER_URL=https://openai.com/chatgpt-user.json
#FS_BOT_LIST_DUCKDUCKBOT_URL=https://duckduckgo.com/duckduckbot.json
#FS_BOT_LIST_DUCKASSISTBOT_URL=https://duckduckgo.com/duckassistbot.json
#FS_BOT_LIST_AWS_URL=https://ip-ranges.amazonaws.com/ip-ranges.json
#FS_BOT_LIST_GCP_URL=https://www.gstatic.com/ipranges/cloud.json
#FS_BOT_LIST_AZURE_URL=https://www.microsoft.com/en-us/download/details.aspx?id=56519
#FS_BOT_LIST_ORACLE_URL=https://docs.oracle.com/en-us/iaas/tools/public_ip_ranges.json
#FS_BOT_LIST_DIGITALOCEAN_URL=https://digitalocean.com/geo/google.csv
#FS_BOT_LIST_CLOUDFLARE_URL=https://api.cloudflare.com/client/v4/ips

# --- Logs ---
FS_LOG_LEVEL=info
