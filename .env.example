# finger-sniffer — configuração compartilhada por todas as units (EnvironmentFile).
# Instalado como /finger-sniffer/etc/finger-sniffer.env no primeiro deploy e nunca sobrescrito depois.
# Não há segredos de terceiros: conta ACME e chaves são geradas em /finger-sniffer/var/.

# --- Rede ---
FS_LISTEN_IPV4=172.233.24.85
FS_LISTEN_IPV6=2600:3c0d::f03c:93ff:fe26:8fd9
FS_MAX_CONNS=200

# --- Captura (capture) ---
FS_CAPTURE_IFACE=eth0
# Portas excluídas da captura (gerência + API)
FS_CAPTURE_EXCLUDE_PORTS=48022,48161,9000,9001
FS_CAPTURE_SNAPLEN=65535

# --- Barramento ---
FS_NATS_URL=nats://127.0.0.1:4222
FS_PRODUCER_BUFFER_MAX_AGE=30s
FS_PRODUCER_BUFFER_MAX_BYTES=16777216

# --- Store e retenção ---
FS_STORE_DB=/finger-sniffer/var/store/finger-sniffer.sqlite
FS_RETENTION=10m
FS_STORE_MAX_BYTES=2147483648
FS_PCAP_MAX_BYTES_PER_CONN=16777216
FS_RAW_BODY_MAX_BYTES=1048576
FS_TCP_SEGMENTS_TRACKED=32
FS_P0F_DB=/finger-sniffer/etc/p0f.fp

# --- API (store, sem captura) ---
FS_API_HTTPS_PORT=9000
FS_API_HTTP_PORT=9001

# --- Web (portas capturadas) ---
FS_WEB_TCP_PORTS=80,443,8080,8443
FS_WEB_UDP_PORTS=443
FS_HTDOCS=/finger-sniffer/htdocs
FS_IDLE_DEFAULT=120s
FS_IDLE_MAX=600s
FS_DELAY_MAX=60s
FS_SIZE_MAX=67108864
FS_HSIZE_MAX=1048576
FS_MAX_H2_PRIORITY_FRAMES=10000

# --- Raw (portas cruas: porta:modo) ---
FS_RAW_PORTS=7:echo,21:banner,22:banner,25:banner,110:banner,143:banner,587:banner,993:tls-banner

# --- DNS autoritativo ---
FS_DNS_ZONE=dns-monitor.tmsoft.com.br
FS_DNS_TTL=5s
FS_DNS_RRL_PER_IP=20

# --- Certificados (ACME) ---
FS_CERT_DIR=/finger-sniffer/var/certs
FS_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# E-mail da conta ACME (opcional, não é segredo)
FS_ACME_EMAIL=
FS_CERT_NAMES_DNS01=dns-monitor.tmsoft.com.br,*.dns-monitor.tmsoft.com.br
FS_CERT_NAMES_HTTP01=vps602.tmsoft.com.br,fingerprint.tmsoft.com.br,tcp.tmsoft.com.br,udp.tmsoft.com.br

# --- Logs ---
FS_LOG_LEVEL=info
